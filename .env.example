# Postgres — audit trail. Pooled connection string (Neon/Supabase pooler works).
DATABASE_URL=postgresql://user:password@host:5432/trace

# Anthropic — Explain + Act layers via the Vercel AI SDK.
ANTHROPIC_API_KEY=sk-ant-

# Razorpay test mode. Dev-time only: used to verify the settlement recon
# response shape. Not a runtime data path — runtime reads data/synthetic/.
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
# base64 of "<key_id>:<key_secret>", consumed by .mcp.json
RAZORPAY_MCP_TOKEN=

# Langfuse — wired Sep 2 alongside the first Claude call sites.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com

# Inngest — durable pipeline.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
