# Postgres, for the audit trail. Use the POOLED connection string here
# (Neon or Supabase pooler). Migrations want the DIRECT one instead.
DATABASE_URL=postgresql://user:password@host:5432/trace

# Anthropic, for the Investigate, Explain and Act layers.
# The screen works without this. A key is only needed to ask a live question
# or to re-record the committed answers and drafts.
ANTHROPIC_API_KEY=sk-ant-

# Optional. How many live questions one server process will answer before it
# declines, so a deployed demo cannot run up a bill. Defaults to 40.
EXPLAIN_MAX_QUESTIONS=40
