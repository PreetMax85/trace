      "id": "note-27",
      "type": "text",
      "x": 360,
      "y": 606,
      "width": 500.50000000000006,
      "height": 32.5,
      "fontSize": 13,
      "fontFamily": 1,
      "text": "Every record id in it is a link that scrolls to that row and opens it.\nThe answer says whether it was written just now or saved earlier.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every record id in it is a link that scrolls to that row and opens it.\nThe answer says whether it was written just now or saved earlier.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
