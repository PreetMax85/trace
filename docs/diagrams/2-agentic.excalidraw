      "id": "note-19",
      "type": "text",
      "x": 1080,
      "y": 140,
      "width": 228.8,
      "height": 162.5,
      "fontSize": 13,
      "fontFamily": 1,
      "text": "Four tools. All read-only.\nAll over the batch Detect\nALREADY computed, so\nnot one of them re-derives\na figure.\n\nlistRecords reports its own\ntruncation, because a model\nhanded a silently shortened\nlist will state 25 as the total.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Four tools. All read-only.\nAll over the batch Detect\nALREADY computed, so\nnot one of them re-derives\na figure.\n\nlistRecords reports its own\ntruncation, because a model\nhanded a silently shortened\nlist will state 25 as the total.",
      "autoResize": true,
      "lineHeight": 1.25
    },
