      "type": "text",
      "x": 720,
      "y": 862,
      "width": 231.00000000000003,
      "height": 60,
      "fontSize": 12,
      "fontFamily": 1,
      "text": "A draft quoting a figure its record\ndoes not carry cannot be confirmed.\nChecked on the server, not just by\ngreying out the button.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A draft quoting a figure its record\ndoes not carry cannot be confirmed.\nChecked on the server, not just by\ngreying out the button.",
      "autoResize": true,
      "lineHeight": 1.25
    },
