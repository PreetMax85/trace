      "height": 21.25,
      "fontSize": 17,
      "fontFamily": 1,
      "text": "CITATION GATE",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "box-21",
      "originalText": "CITATION GATE",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2088985797,
      "version": 1,
      "versionNonce": 191278455,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1757030000000,
      "link": null,
      "locked": false,
      "id": "note-23",
      "type": "text",
      "x": 400,
      "y": 408,
      "width": 464.75000000000006,
      "height": 65,
      "fontSize": 13,
      "fontFamily": 1,
      "text": "Citations are read out of the answer's own prose. There is no\nsecond list of claimed ids for it to disagree with. A record this\nbatch does not hold keeps its words, loses its link, and is named\non screen as invented. Verdict: INVALID_CITATION.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Citations are read out of the answer's own prose. There is no\nsecond list of claimed ids for it to disagree with. A record this\nbatch does not hold keeps its words, loses its link, and is named\non screen as invented. Verdict: INVALID_CITATION.",
      "autoResize": true,
      "lineHeight": 1.25
    },
