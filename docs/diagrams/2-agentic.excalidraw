      "fontSize": 17,
      "fontFamily": 1,
      "text": "The answer, on screen",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "box-25",
      "originalText": "The answer, on screen",
      "autoResize": false,
      "lineHeight": 1.25
