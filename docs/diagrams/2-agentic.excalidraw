      "id": "note-34",
      "type": "text",
      "x": 390,
      "y": 862,
      "width": 217.8,
      "height": 60,
      "fontSize": 12,
      "fontFamily": 1,
      "text": "An answer that names a record\nthat does not exist cannot pass\nas one that does. The gate firing\nis SHOWN, not hidden.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An answer that names a record\nthat does not exist cannot pass\nas one that does. The gate firing\nis SHOWN, not hidden.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
