      "id": "note-40",
      "type": "text",
      "x": 1050,
      "y": 862,
      "width": 244.20000000000002,
      "height": 60,
      "fontSize": 12,
      "fontFamily": 1,
      "text": "Nothing is sent and nothing is filed.\nAn actions row exists if and only if\na person clicked Confirm, so a query\nfor unapproved actions returns none.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nothing is sent and nothing is filed.\nAn actions row exists if and only if\na person clicked Confirm, so a query\nfor unapproved actions returns none.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1971624656,
      "version": 1,
      "versionNonce": 113502030,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1757030000000,
      "link": null,
      "locked": false,
      "id": "note-41",
      "type": "text",
      "x": 60,
      "y": 950,
      "width": 985.6000000000001,
      "height": 17.5,
      "fontSize": 14,
      "fontFamily": 1,
      "text": "The classifying and the arithmetic sit OUTSIDE all of this. Detect never calls a model, so no gate is load-bearing for a number.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The classifying and the arithmetic sit OUTSIDE all of this. Detect never calls a model, so no gate is load-bearing for a number.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
