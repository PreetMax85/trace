      "type": "text",
      "x": 60,
      "y": 700,
      "width": 715.0000000000001,
      "height": 25,
      "fontSize": 20,
      "fontFamily": 1,
      "text": "Four gates, and each one is a place the product refuses the model",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Four gates, and each one is a place the product refuses the model",
      "autoResize": true,
      "lineHeight": 1.25
    },
