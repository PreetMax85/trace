      "type": "text",
      "x": 60,
      "y": 862,
      "width": 217.8,
      "height": 60,
      "fontSize": 12,
      "fontFamily": 1,
      "text": "Read-only, and each layer's list\nis separate on purpose. A write\nattempt is refused before it runs\nand recorded as BLOCKED_WRITE.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Read-only, and each layer's list\nis separate on purpose. A write\nattempt is refused before it runs\nand recorded as BLOCKED_WRITE.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
