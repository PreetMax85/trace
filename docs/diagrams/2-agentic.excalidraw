      "width": 446.6,
      "height": 35,
      "fontSize": 28,
      "fontFamily": 1,
      "text": "What is actually agentic here",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What is actually agentic here",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1680368615,
      "version": 1,
