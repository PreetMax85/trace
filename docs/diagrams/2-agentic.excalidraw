      "isDeleted": false,
      "boundElements": null,
      "updated": 1757030000000,
      "link": null,
      "locked": false,
      "id": "note-2",
      "type": "text",
      "x": 60,
      "y": 72,
      "width": 515.9000000000001,
      "height": 52.5,
      "fontSize": 14,
      "fontFamily": 1,
      "text": "The model is not asked to produce an answer. It is handed read-only\ntools and left to decide which to call, in what order, until it can\nanswer. Every way out of that loop is gated.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The model is not asked to produce an answer. It is handed read-only\ntools and left to decide which to call, in what order, until it can\nanswer. Every way out of that loop is gated.",
      "autoResize": true,
      "lineHeight": 1.25
    },
