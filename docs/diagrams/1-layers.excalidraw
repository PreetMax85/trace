      "width": 521.95,
      "height": 32.5,
      "fontSize": 13,
      "fontFamily": 1,
      "text": "Prices every fee against Razorpay's published rate card within ₹1,\nthen rolls the month up against the single GSTR-2B line. Arithmetic only.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Prices every fee against Razorpay's published rate card within ₹1,\nthen rolls the month up against the single GSTR-2B line. Arithmetic only.",
      "autoResize": true,
      "lineHeight": 1.25
    },
