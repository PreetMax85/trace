      "link": null,
      "locked": false,
      "id": "note-20",
      "type": "text",
      "x": 900,
      "y": 548,
      "width": 307.45000000000005,
      "height": 65,
      "fontSize": 13,
      "fontFamily": 1,
      "text": "4 refunds. Correct, not missing. This money\nis explained the moment you know a refund\nhappened, which is exactly the thing a\nspreadsheet cannot tell you.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4 refunds. Correct, not missing. This money\nis explained the moment you know a refund\nhappened, which is exactly the thing a\nspreadsheet cannot tell you.",
      "autoResize": true,
      "lineHeight": 1.25
    },
